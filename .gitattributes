# Normalize line endings: LF in the repository, native endings in working copies.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.slnx    text
*.props   text
*.md      text
*.txt     text
*.json    text
*.yml     text

# Binary test data (MOD files, generated outputs)
*.mod     binary
*.dmf     binary
*.xgm     binary
*.xgm2    binary
*.wav     binary
*.vgm     binary
*.gz      binary
*.sh      text eol=lf
