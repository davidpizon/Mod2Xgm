<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft code coverage settings for Microsoft.Testing.Extensions.CodeCoverage (passed with the coverage-settings
     option), used by CI and locally. The command line is in docs/testing.md.
     Measures the Mod2Xgm application assembly only; test assemblies are excluded by default.
     Not named coverage*.xml: the repository .gitignore ignores that pattern. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]Mod2Xgm\.dll$</ModulePath>
              </Include>
            </ModulePaths>
            <Attributes>
              <Exclude>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
