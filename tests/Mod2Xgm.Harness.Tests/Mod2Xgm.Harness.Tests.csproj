<Project Sdk="Microsoft.NET.Sdk">

  <!-- xUnit v3 tests for the accuracy harness (tools/Mod2Xgm.Harness). Shared settings come from ../../Directory.Build.props.
       Code coverage is measured on Mod2Xgm.Tests only (docs/testing.md#code-coverage). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/Mod2Xgm.Harness/Mod2Xgm.Harness.csproj" />
  </ItemGroup>

</Project>
