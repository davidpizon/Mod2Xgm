// SGDK resource file for the DMF probes (plan T4.3): each probe exported from DefleMask as VGM, turned into XGM2.
// Run from this folder: java -jar "%GDK%\bin\rescomp.jar" probes.res out\probes.s (see README.md).
XGM2 fm_note "vgm/fm-note.vgm"
XGM2 psg_note "vgm/psg-note.vgm"
XGM2 dac_sample "vgm/dac-sample.vgm"
XGM2 custom_hz "vgm/custom-hz.vgm"
XGM2 ext_ch3 "vgm/ext-ch3.vgm"
