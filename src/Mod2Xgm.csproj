<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (target framework, warnings-as-errors, analyzers) live in ../Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Trim/AOT analyzers at build time (IL2xxx/IL3xxx), which fail the build like any other warning. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mod2Xgm.Tests" />
  </ItemGroup>

</Project>
