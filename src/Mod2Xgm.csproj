<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings (target framework, warnings-as-errors, analyzers) live in ../Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Trim/AOT analyzers at build time (IL2xxx/IL3xxx), which fail the build like any other warning. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The version of local builds; a release build takes it from the tag instead (.github/workflows/release.yml). -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="NWaves" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mod2Xgm.Tests" />
  </ItemGroup>

</Project>
