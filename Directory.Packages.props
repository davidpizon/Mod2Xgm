<Project>
  <!-- Central package management: every package version is pinned here, not in project files. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Application">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="NWaves" Version="0.9.6" />
    <!-- Console output in fancy mode (ADR 0077); core package only, Spectre.Console.Cli is not AOT-compatible. -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
  <ItemGroup Label="Harness">
    <!-- tools/Mod2Xgm.Harness only, never the converter (ADR 0053). -->
    <PackageVersion Include="R128Net" Version="1.1.2" />
    <!-- Runs the pretrained listening models in the harness only, MIT (ADR 0104). -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <!-- Test doubles (ADR 0081); never referenced from src/. -->
    <PackageVersion Include="Moq" Version="4.21.0" />
  </ItemGroup>
</Project>